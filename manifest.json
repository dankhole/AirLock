{
  "manifest_version": 3,
  "name": "Airlock",
  "version": "1.1.2",
  "description": "Add intentional friction before accessing distracting websites.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "webNavigation"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "shared/daily-lock.js",
      "shared/content-controls.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/page-state.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "shared/content-controls.js",
        "shared/page-state.js",
        "content/controls/runtime.js",
        "content/controls/sites/youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "shared/content-controls.js",
        "shared/page-state.js",
        "content/controls/runtime.js",
        "content/controls/sites/instagram.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "shared/content-controls.js",
        "shared/page-state.js",
        "content/controls/runtime.js",
        "content/controls/sites/facebook.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
